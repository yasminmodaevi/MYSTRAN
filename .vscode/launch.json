{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Run AeroPLM",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "DATABASE_URL": "postgresql://user:password@localhost:5432/aeroplm",
                "VAULT_PATH": "./vault",
                "SECRET_KEY": "dev_secret_key_for_vscode"
            }
        }
    ]
}
